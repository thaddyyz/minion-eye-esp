# Copy this file to ".env" and fill it in. ".env" is ignored by git.

# Your home WiFi (2.4 GHz only - the ESP32-C3 cannot use 5 GHz)
WIFI_SSID=your-network-name
WIFI_PASS=your-password

# Optional: change the fallback access point and the .local name
# AP_SSID=MinionEye
# AP_PASS=minion123
# MDNS_NAME=minioneye
